# macOS
.DS_Store
**/.DS_Store

# Python bytecode
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/
.pytest_cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Workspace runtime outputs
rna_agent_system/workspace/*
!rna_agent_system/workspace/.gitkeep
rna_agent_system/test_workspace_*/
rna_agent_system/workspace_test_*/

# Literature-search cache (regenerable; experiment verdicts/summaries under
# experiments/results/ ARE committed as the paper's evidence base)
rna_agent_system/experiments/lit_cache/

# Compiled binaries in submodules (should be rebuilt on target host)
rna_agent_system/external_repos/LinearDesign/bin/

# Model weights (managed outside git — download or copy to server directly)
*.pt
*.pth
*.ckpt
*.safetensors

# Sequence files (runtime generated)
*.fasta
# ...but curated benchmark inputs are source data, not runtime output
!rna_agent_system/data/benchmarks/**/*.fasta

# Reference genomes / transcriptomes (auto-downloaded, do NOT commit)
rna_agent_system/data/references/species/*/
!rna_agent_system/data/references/species/.gitkeep
rna_agent_system/data/references/**/*.fa
rna_agent_system/data/references/**/*.fasta
rna_agent_system/data/references/**/*.fa.gz
rna_agent_system/data/references/**/*.fna.gz

# Environment / secrets
.env

# Conda / virtualenv
.conda/
.venv/
venv/

# Logs
*.log

# Stray vendor scripts
rna_agent_system/get-docker.sh

# Build artifacts inside submodules
**/build/
**/dist/

# RNA_agent_system internal caches
rna_agent_system/**/__pycache__/
rna_agent_system/**/*.pyc
rna_agent_system/**/.pytest_cache/
rna_agent_system/microservices/odesign_service/resident_outputs/
